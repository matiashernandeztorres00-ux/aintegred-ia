# Put your API key here. NEVER put it in index.html or scripts/app.js.
OPENAI_API_KEY=pon_tu_api_key_aqui

# Model used by the backend. You can change this if your API account has another model available.
OPENAI_MODEL=gpt-5.6

# Port for the server.
PORT=3000

# For same-origin hosting, leave this as *.
# If the frontend is hosted elsewhere, set it to its exact origin, e.g. https://tu-sitio.example
CORS_ORIGIN=*
